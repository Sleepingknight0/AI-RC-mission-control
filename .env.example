AICL_CORE_HOST=127.0.0.1
AICL_CORE_PORT=8787
AICL_BROWSER_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Generated per launch by scripts/Start-Dev.ps1. Never commit real values.
AICL_BROWSER_TOKEN=<random-capability-at-least-16-characters>
AICL_CONNECTOR_TOKEN=<different-random-capability-at-least-16-characters>
VITE_AICL_BROWSER_TOKEN=<same-value-as-AICL_BROWSER_TOKEN>
AICL_CORE_DB=.data/aicl-core.db
AICL_CONNECTOR_DB=.data/aicl-connector.db
AICL_CONNECTOR_TRANSPORT=local
AICL_PROJECT_ROOTS=C:\Projects
AICL_LOG_LEVEL=info
