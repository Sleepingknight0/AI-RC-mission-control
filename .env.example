# AICL Mission Control environment
#
# Since M8.3 the authoritative settings live in the typed persistent config at
#   %LOCALAPPDATA%\AICL Mission Control\config.json
# created on first Core/Connector startup. Everything below is an OPTIONAL
# override for development, tests, and emergency recovery. Overrides are applied
# in memory only and are never written back to config.json.

# --- Secrets: never stored in config.json, never committed -------------------
# Generated per launch by scripts/Start-Dev.ps1.
AICL_CONNECTOR_TOKEN=<random-capability-at-least-16-characters>

# --- Config location ---------------------------------------------------------
# Point both processes at an alternate config file (used by tests).
# AICL_CONFIG_PATH=C:\path\to\config.json

# --- Core --------------------------------------------------------------------
# Loopback only: 127.0.0.1 or ::1.
AICL_CORE_HOST=127.0.0.1
AICL_CORE_PORT=8787
# Comma-separated exact origins (no trailing slash, no path, no wildcard).
# The effective Core origin is always allowed and does not need to be listed.
AICL_BROWSER_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Connector ---------------------------------------------------------------
AICL_CONNECTOR_PORT=8788
# ws://<core-host>:<core-port>/connector is derived when unset.
# AICL_CORE_CONNECTOR_URL=ws://127.0.0.1:8787/connector

# --- Provider ----------------------------------------------------------------
AICL_PROVIDER=codex
# AICL_CODEX_PROFILE=default
# CODEX_HOME=C:\Users\<you>\.codex

# --- Workspace ---------------------------------------------------------------
# Semicolon-separated on Windows; every root must be an existing absolute path.
AICL_PROJECT_ROOTS=C:\Projects
AICL_PROJECT_PATH=C:\Projects\my-project

# --- Operational paths -------------------------------------------------------
# AICL_CORE_DB_PATH=C:\path\to\aicl-core.db
# AICL_CONNECTOR_DB_PATH=C:\path\to\aicl-connector.db
# AICL_LOG_DIR=C:\path\to\logs
# AICL_BACKUP_DIR=C:\path\to\backups
# Optional explicit CLI path used by Doctor when Tailscale is not on PATH.
# AICL_TAILSCALE_PATH=C:\Program Files\Tailscale\tailscale.exe

# --- Development-only --------------------------------------------------------
# Split-origin dev override; production derives ws:/wss: from window.location.
# VITE_CORE_WS_URL=ws://127.0.0.1:8787/ws
# Serve a Web build from a non-default directory.
# AICL_WEB_DIST_PATH=C:\path\to\apps\web\dist
# Opt in to the real-provider end-to-end test.
# AICL_REAL_CODEX=1
